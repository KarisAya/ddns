{
  "api_key": "your-cloudflare-api-token",
  "interval_seconds": 60,
  "records": [
    {
      "type": "AAAA",
      "name": "ipv6.example.com",
      "check_url": "https://your-worker.example.workers.dev/ipv6",
      "update_url": "https://api.cloudflare.com/client/v4/zones/<zone-id>/dns_records/<ipv6-record-id>"
    },
    {
      "type": "A",
      "name": "ipv4.example.com",
      "check_url": "https://your-worker.example.workers.dev/ipv4",
      "update_url": "https://api.cloudflare.com/client/v4/zones/<zone-id>/dns_records/<ipv4-record-id>"
    }
  ]
}